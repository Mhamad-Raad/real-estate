# Copy to .env for local dev. Never commit .env (see repo .gitignore).
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local dev)
DB_NAME=landalloc_dev
DB_USER=landalloc
DB_PASSWORD=landalloc_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend dev origin (Vite) for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis — background jobs (template→PDF generation, later OCR).
# Compose overrides this to redis://redis:6379/0 on the container network.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Generated + uploaded PDFs, and the .docx letter templates beneath them.
# Compose overrides DOCUMENTS_ROOT to /data/documents (a volume shared with the worker).
# DOCUMENTS_ROOT=../LandAllocationData/documents
# LETTER_TEMPLATES_ROOT=../LandAllocationData/documents/_templates

# Size limits (bytes). The upload cap bounds what a user may send; the generated cap is a
# runaway backstop for files the server produces itself, such as the compiled case export —
# which merges documents that were each already accepted, so it can legitimately be larger.
# MAX_UPLOAD_BYTES=26214400
# MAX_GENERATED_BYTES=209715200

# Headless LibreOffice, used to render .docx letters to PDF with correct RTL.
# Native macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_BIN=soffice
