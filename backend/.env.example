# Copy to .env for local dev. Never commit .env (see repo .gitignore).
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local dev)
DB_NAME=landalloc_dev
DB_USER=landalloc
DB_PASSWORD=landalloc_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend dev origin (Vite) for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
