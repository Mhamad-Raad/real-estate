# Dev image — pinned to Python 3.12 for prod parity (avoids the 3.14 C-extension wheel risk).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Headless LibreOffice renders the generated letters (§6.6). The Noto fonts must be installed
# system-wide: if the .docx names a face the image lacks, LibreOffice silently substitutes one
# and the Sorani letterforms come out wrong on a document that goes to a ministry.
#
# OCR (§6.5): Tesseract plus poppler, which rasterises a PDF page for the engine to read.
# NOTE ON KURDISH: Tesseract ships **no Central Kurdish (Sorani, `ckb`) model** — upstream
# tessdata has only `kmr` (Kurmanji), which is the wrong language in the wrong script. Sorani is
# written in Arabic script, so `ara` and the wider `script/Arabic` model are the closest
# available starting point and what the accuracy spike measures. libgl1/libglib are OpenCV's
# runtime deps (the headless wheel still links them).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-writer-nogui \
        fonts-noto-core \
        tesseract-ocr \
        tesseract-ocr-ara \
        tesseract-ocr-eng \
        tesseract-ocr-script-arab \
        poppler-utils \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# psycopg[binary] ships wheels, so no build toolchain is needed here.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Source is bind-mounted in compose for hot reload; this COPY is the fallback for a plain build.
COPY . .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
