# The app's version, declared once for the whole monorepo. Read by the backend
# (backend/common/version.py), by the frontend build (frontend/vite.config.ts), and baked into
# the container images as APP_VERSION / APP_BUILD at image-build time.
#
# BUILD is bumped BY HAND every time an image is handed to the office. It is deliberately NOT
# derived from git: `git rev-list --count` is not monotonic across branches (measured 2026-08-09
# — dev 204, main 28), so a build cut from main would number LOWER than a dev build and the
# number would run backwards after a merge. A committed integer is branch-independent and works
# in a build that has no .git at all.
#
# The keys are named APP_* so this file is itself a valid Docker Compose `env_file` — the
# container gets them with no second parser and no risk of the two drifting.
APP_VERSION=1.3.1
APP_BUILD=5
