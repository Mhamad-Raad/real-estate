# --- Local AI guidance / config (kept out of the repo per project preference) ---
CLAUDE.md
.claude/settings.json
.claude/settings.local.json

# --- Secrets / env ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# --- Runtime data (lives in Desktop/LandAllocationData, never in repo) ---
/data/
# The backend's default DOCUMENTS_ROOT resolves to <repo>/LandAllocationData/documents whenever
# the env var is unset, so a native run puts citizen PDFs *inside* the repo. Only `/data/` was
# ignored — a path nothing writes to — which left the real one exposed to `git add -A` (It.8).
/LandAllocationData/
*.dump
*.sql

# --- Python / Django / Celery ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
# Python virtualenvs. **Anchored** — an unanchored `env/` also swallowed `deploy/env/`, so the
# production env template was invisible to git and a fresh clone had no idea which variables the
# stack needs (caught while writing it, 2026-08-11).
/env/
backend/env/
*.log
db.sqlite3
staticfiles/
mediafiles/
celerybeat-schedule*
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node / React / Vite ---
node_modules/
frontend/dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Docker ---
# (compose files ARE tracked; only local overrides are ignored)
docker-compose.override.yml

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# OCR samples — real government ID scans. Personal data: never commit these.
*.jpeg
*.jpg
*.png
!frontend/public/**
samples/

# Acceptance-testing findings (It.7) — local working notes, not repo content.
# May quote real pilot records, so it deliberately stays out of git.
/FINDINGS.md

# Word lock files (created whenever a template is open in Word)
~$*

# Production secrets — never commit (§12). The template beside it IS committed: it is the only
# record of what the office install has to be told.
deploy/.env
!deploy/.env.example
